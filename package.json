{
  "name": "offlimits",
  "version": "0.1.0",
  "description": "One list of what your AI assistants may not see or touch, applied by a guard, an output filter and a standard boundary signal.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Black Canyon Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackCanyonSoftware/off-limits_filter_BCS.git"
  },
  "bin": {
    "offlimits": "dist/cli/main.js",
    "offlimits-guard": "dist/guard-cjs/guard/main.js",
    "offlimits-filter": "dist/guard-cjs/filter/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "npm run build && node scripts/demo.mjs",
    "measure": "npm run build && node scripts/measure-startup.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:ci": "npm run check && npm audit --omit=dev --audit-level=high",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
